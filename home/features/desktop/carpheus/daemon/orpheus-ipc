#!/usr/bin/env python3
"""Tiny stdin/stdout client for the Orpheus coordinator Unix socket.

Usage:
  orpheus-ipc subscribe <socket>
  orpheus-ipc call <socket> <method> ['{"key": value}'] [request-id]
"""
from __future__ import annotations

import json
import socket
import sys


def connect(path: str) -> socket.socket:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(path)
    return sock


def subscribe(path: str) -> int:
    sock = connect(path)
    with sock.makefile("r", encoding="utf-8") as stream:
        for line in stream:
            print(line.rstrip("\n"), flush=True)
    return 0


def call(path: str, method: str, params: str, request_id: int = 1) -> int:
    try:
        parsed = json.loads(params) if params else {}
    except ValueError:
        parsed = {}
    if not isinstance(parsed, dict):
        parsed = {}
    sock = connect(path)
    sock.sendall(
        (
            json.dumps({"id": request_id, "method": method, "params": parsed}) + "\n"
        ).encode()
    )
    with sock.makefile("r", encoding="utf-8") as stream:
        for line in stream:
            try:
                response = json.loads(line)
            except ValueError:
                continue
            if response.get("id") == request_id:
                print(json.dumps(response, ensure_ascii=False), flush=True)
                return 0 if response.get("ok") else 2
    return 3


def main() -> int:
    if len(sys.argv) < 3:
        return 2
    mode, path = sys.argv[1], sys.argv[2]
    if mode == "subscribe":
        return subscribe(path)
    if mode == "call":
        if len(sys.argv) < 4:
            return 2
        try:
            request_id = int(sys.argv[5]) if len(sys.argv) > 5 else 1
        except ValueError:
            request_id = 1
        return call(
            path,
            sys.argv[3],
            sys.argv[4] if len(sys.argv) > 4 else "{}",
            request_id,
        )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
