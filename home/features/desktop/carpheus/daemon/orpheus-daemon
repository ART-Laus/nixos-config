def is_webp(data: bytes) -> bool:
    return len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP"


def normalize_artwork(data: bytes, size: int) -> bytes:
    """Convert WebP art to PNG; the shell Qt build has no WebP image plugin."""
    if not is_webp(data):
        return data
    try:
        result = subprocess.run(
            [
                "magick", "webp:-", "-resize", f"{int(size)}x{int(size)}>", "png:-",
            ],
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        log(f"artwork convert: {type(exc).__name__}", "warn")
        return data
    return result.stdout


def redact_command(command: list[Any]) -> list[Any]:
    """Remove signed stream URLs from diagnostic logs."""
    result: list[Any] = []
    for item in command:
        text = str(item)
        if "://" in text:
            text = text.split("?", 1)[0] + "?<redacted>"
        result.append(text)
    return result


def clamp_int(value: Any, low: int, high: int, default: int = 0) -> int:
    try:
        return max(low, min(high, int(value)))
    except (TypeError, ValueError):
        return default


def id_list(value: Any, limit: int = 500) -> list[str]:
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list):
        return []
    return [str(item) for item in value[:limit] if str(item)]


def normalize_media(value: Any) -> Any:
    """Fill the cover id Navidrome omits from some OpenSubsonic responses."""
    if isinstance(value, list):
        for item in value:
            normalize_media(item)
    elif isinstance(value, dict):
        cover = value.get("coverArt")
        if not cover:
            if "albumId" in value or "title" in value:
                cover = value.get("albumId") or value.get("parent") or value.get("id")
            elif "songCount" in value and "name" in value:
                cover = value.get("id")
        if cover:
            value["coverArt"] = str(cover)
        for item in value.values():
            normalize_media(item)
    return value


def normalize_playlist(value: Any) -> Any:
    """Expose Subsonic playlist entries under the same key as album songs."""
    if isinstance(value, dict):
        entries = value.get("entry")
        if entries is not None and "song" not in value:
            value["song"] = entries
        return normalize_media(value)
    return value


def validate_request(method: str, params: Any) -> dict[str, Any]:
    """Strictly bound local IPC input; the socket is never network-exposed."""
    if method not in VALID_METHODS:
        raise RuntimeError(f"unknown method: {method}")
    if not isinstance(params, dict):
        raise RuntimeError("params must be an object")
    if len(params) > 64:
        raise RuntimeError("too many parameters")
    for key, value in params.items():
        if len(str(key)) > 64:
            raise RuntimeError("parameter name too long")
        if isinstance(value, str) and len(value) > 4096:
            raise RuntimeError("parameter value too long")
        if isinstance(value, list) and len(value) > 500:
            raise RuntimeError("parameter list too long")
    if len(json.dumps(params, ensure_ascii=False)) > 65536:
        raise RuntimeError("request too large")
    return params


def log(message: str, level: str = "info") -> None:
    """Structured log with no credentials or full stream URLs."""
    print(
        json.dumps(
            {"ts": round(time.time(), 3), "level": level, "msg": message},
            ensure_ascii=False,
        ),
        flush=True,
    )


def read_config() -> dict[str, str]:
    cfg: dict[str, str] = {}
    with CONFIG_PATH.open("r", encoding="utf-8") as handle:
        for raw in handle:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            cfg[key.strip()] = value.strip()
    missing = [
        key
        for key in (
            "CARPPHEUS_NAVIDROME_URL",
            "CARPPHEUS_NAVIDROME_USER",
            "CARPPHEUS_NAVIDROME_PASSWORD",
        )
        if not cfg.get(key)
    ]
    if missing:
        raise RuntimeError(f"missing config keys: {', '.join(missing)}")
    return cfg


