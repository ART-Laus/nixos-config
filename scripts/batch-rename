#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
    echo "Usage: batch-rename <pattern> <replacement> <files...>" >&2
    exit 1
fi

PATTERN="$1"
REPLACEMENT="$2"
shift 2

for f in "$@"; do
    [ -f "$f" ] || { echo "Not found: $f" >&2; continue; }
    NEW=$(echo "$f" | sed "s/$PATTERN/$REPLACEMENT/")
    if [ "$f" != "$NEW" ]; then
        mv "$f" "$NEW"
        echo "Renamed: $f → $NEW"
    fi
done
